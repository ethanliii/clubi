# App (Expo). The only value the phone needs.
EXPO_PUBLIC_CONVEX_URL=

# Server keys are NOT read from this file by the backend. Set them on the Convex deployment:
#   npx convex env set EVENTBRITE_TOKEN <value>
#   npx convex env set TICKETMASTER_KEY <value>      (optional: Ticketmaster import is skipped without it)
#   npx convex env set GOOGLE_MAPS_KEY <value>       (optional: Google Places enrichment is skipped without it)
# For local scraper tests only, the same names may be put in .env.local (git-ignored). Never commit a key.
