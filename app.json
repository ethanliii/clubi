{
  "expo": {
    "name": "clubi",
    "slug": "clubi",
    "description": "Rank the spots you go out to, see where your friends went last night, and get picks for tonight that match your taste.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clubi.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.clubi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "clubi uses your location to show what's worth doing near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "clubi lets you add a photo from your library to a post."
        }
      ]
    ],
    "scheme": "clubi",
    "backgroundColor": "#ffffff",
    "experiments": {
      "typedRoutes": true
    }
  }
}
